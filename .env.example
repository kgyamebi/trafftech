# Session signing secret. Generate a long random string in production.
AUTH_SECRET=

# Comma-separated emails that receive the admin role on signup.
ADMIN_EMAILS=

# Optional. When unset, Driver Intelligence uses the on-device explainer.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# Map provider. "open" uses OpenStreetMap search and routing. "off" shows an honest unavailable state.
# Traffic and speed-limit datasets are not connected in either mode.
NEXT_PUBLIC_MAP_PROVIDER=open
